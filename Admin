/* ---- Subida de una foto al bucket de Storage ----
   Ruta: product-images/{product_id}/{color_id}/{nombre-archivo}
   Se sube el archivo tal cual (sin recomprimir), con el access_token
   de la sesión en el header Authorization (no la anon key sola). */
function sanitizarNombreArchivo(nombre) {
  const punto = nombre.lastIndexOf(".");
  const base = punto > -1 ? nombre.slice(0, punto) : nombre;
  const ext = punto > -1 ? nombre.slice(punto + 1).toLowerCase() : "";
  const baseLimpia = slugify(base) || "foto";
  return ext ? `${baseLimpia}.${ext}` : baseLimpia;
}

async function subirFotoAStorage(productId, colorId, file, indiceParaNombre) {
  const sesion = await obtenerSesionValida();
  if (!sesion) throw new Error("Sesión vencida, vuelve a iniciar sesión.");

  // Prefijo con timestamp para que dos fotos con el mismo nombre no se pisen
  const nombreArchivo = `${Date.now()}-${indiceParaNombre}-${sanitizarNombreArchivo(file.name)}`;
  const ruta = `${productId}/${colorId}/${nombreArchivo}`;

  const res = await fetch(`${CONFIG.supabaseUrl}/storage/v1/object/product-images/${ruta}`, {
    method: "POST",
    headers: {
      apikey: CONFIG.supabaseAnonKey,
      Authorization: `Bearer ${sesion.access_token}`,
      "Content-Type": file.type || "application/octet-stream"
    },
    body: file
  });
  if (!res.ok) {
    const texto = await res.text();
    throw new Error(`No se pudo subir la foto "${file.name}": HTTP ${res.status} ${texto}`);
  }
  // URL pública (el bucket ya es público)
  return `${CONFIG.supabaseUrl}/storage/v1/object/public/product-images/${ruta}`;
}

/* ---- Borrar un archivo del bucket a partir de su URL pública ----
   Si por algún motivo la foto ya no está en Storage (o la URL no
   calza con el patrón esperado), no se interrumpe el resto del
   guardado — solo se avisa por consola, para no bloquear al usuario
   por un archivo que de todos modos ya no se puede ver en ningún lado. */
async function eliminarArchivoStorage(url) {
  const marcador = "/storage/v1/object/public/product-images/";
  const idx = url.indexOf(marcador);
  if (idx === -1) { console.warn("URL de foto con formato inesperado, no se borra del bucket:", url); return; }
  const ruta = url.slice(idx + marcador.length);

  const sesion = await obtenerSesionValida();
  if (!sesion) throw new Error("Sesión vencida, vuelve a iniciar sesión.");

  const res = await fetch(`${CONFIG.supabaseUrl}/storage/v1/object/product-images/${ruta}`, {
    method: "DELETE",
    headers: {
      apikey: CONFIG.supabaseAnonKey,
      Authorization: `Bearer ${sesion.access_token}`
    }
  });
  if (!res.ok) {
    console.warn(`No se pudo borrar del bucket "${ruta}": HTTP ${res.status}`);
  }
}

/* ---- Validaciones (mismas reglas de negocio que pediste) ---- */
function validarFormulario() {
  const errores = [];
  const nombre = document.getElementById("pfNombre").value.trim();
  const categoriaSel = document.getElementById("pfCategoria").value;
  const categoriaNueva = document.getElementById("pfCategoriaNueva").value.trim();
  const precio = Number(document.getElementById("pfPrecio").value);
  const precioMayorRaw = document.getElementById("pfPrecioMayor").value;
  const descuentoRaw = document.getElementById("pfDescuento").value;

  if (!nombre) errores.push("Falta el nombre del modelo.");
  if (categoriaSel === "__nueva__" && !categoriaNueva) errores.push("Escribe el nombre de la nueva categoría.");
  if (!Number.isFinite(precio) || precio < 0) errores.push("El precio normal debe ser un número mayor o igual a 0.");

  if (precioMayorRaw !== "") {
    const pm = Number(precioMayorRaw);
    if (!Number.isFinite(pm) || pm < 0) errores.push("El precio por mayor debe ser un número válido.");
    else if (Number.isFinite(precio) && pm >= precio) errores.push("El precio por mayor debe ser menor al precio normal.");
  }
  if (descuentoRaw !== "") {
    const d = Number(descuentoRaw);
    if (!Number.isInteger(d) || d < 1 || d > 99) errores.push("El descuento debe ser un número entero entre 1 y 99.");
  }

  if (!coloresForm.length) {
    errores.push("Agrega al menos un color.");
  } else {
    coloresForm.forEach((c, i) => {
      if (!c.name.trim()) errores.push(`El color #${i + 1} necesita un nombre.`);
      if (!c.fotos.length) errores.push(`El color "${c.name.trim() || "#" + (i + 1)}" necesita al menos una foto.`);
    });
  }
  return errores;
}

/* ---- Guardar: crea (Parte 3) o actualiza (Parte 4) según modoFormulario ---- */
document.getElementById("productForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const errBoxGeneral = document.getElementById("pfGeneralError");
  errBoxGeneral.classList.remove("show");

  const errores = validarFormulario();
  if (errores.length) {
    errBoxGeneral.textContent = errores.join(" ");
    errBoxGeneral.classList.add("show");
    return;
  }

  const btnGuardar = document.getElementById("btnGuardarProducto");
  const textoFinalBoton = modoFormulario === "editar" ? "Guardar cambios" : "Guardar producto";
  btnGuardar.disabled = true;
  btnGuardar.innerHTML = `<span class="spinner"></span>Guardando…`;

  try {
    // 1) Resolver categoría (crearla si el usuario escribió una nueva) — igual en ambos modos
    const categoriaSel = document.getElementById("pfCategoria").value;
    let categoriaId, categoriaNombre;
    if (categoriaSel === "__nueva__") {
      categoriaNombre = document.getElementById("pfCategoriaNueva").value.trim();
      const creada = await supabaseFetchAuth("categories", {
        method: "POST",
        headers: { Prefer: "return=representation" },
        body: JSON.stringify({ name: categoriaNombre, sort_order: categoriasCache.length })
      });
      categoriaId = creada[0].id;
    } else {
      categoriaId = Number(categoriaSel);
      const cat = categoriasCache.find(c => c.id === categoriaId);
      categoriaNombre = cat ? cat.name : "";
    }

    const nombre = document.getElementById("pfNombre").value.trim();
    const precio = Number(document.getElementById("pfPrecio").value);
    const precioMayorRaw = document.getElementById("pfPrecioMayor").value;
    const descuentoRaw = document.getElementById("pfDescuento").value;
    const genero = document.getElementById("pfGenero").value;
    const descripcion = document.getElementById("pfDescripcion").value.trim();

    let productId;

    if (modoFormulario === "crear") {
      // 2) Generar el slug (id) único
      productId = await generarSlugUnico(categoriaNombre, nombre);

      // 3) Insertar el producto
      await supabaseFetchAuth("products", {
        method: "POST",
        body: JSON.stringify({
          id: productId,
          name: nombre,
          category_id: categoriaId,
          gender: genero || null,
          description: descripcion || null,
          price: precio,
          price_wholesale: precioMayorRaw !== "" ? Number(precioMayorRaw) : null,
          discount_percent: descuentoRaw !== "" ? Number(descuentoRaw) : null,
          is_active: true,
          sort_order: productosCache.length
        })
      });
    } else {
      // MODO EDITAR: el id nunca cambia
      productId = productoIdEditando;

      // 2) Actualizar los datos generales del producto (sin tocar id ni is_active)
      await supabaseFetchAuth(`products?id=eq.${encodeURIComponent(productId)}`, {
        method: "PATCH",
        body: JSON.stringify({
          name: nombre,
          category_id: categoriaId,
          gender: genero || null,
          description: descripcion || null,
          price: precio,
          price_wholesale: precioMayorRaw !== "" ? Number(precioMayorRaw) : null,
          discount_percent: descuentoRaw !== "" ? Number(descuentoRaw) : null
        })
      });

      // 3) Colores que el usuario quitó: borrar la fila (borra en cascada sus fotos
      //    en la base de datos) y luego borrar los archivos del bucket, uno por uno.
      for (const eliminado of coloresEliminados) {
        await supabaseFetchAuth(`product_colors?id=eq.${eliminado.colorId}`, { method: "DELETE" });
        for (const url of eliminado.urls) {
          await eliminarArchivoStorage(url);
        }
      }

      // 4) Fotos sueltas que el usuario quitó (de un color que sigue existiendo)
      for (const foto of fotosEliminadas) {
        await supabaseFetchAuth(`product_images?id=eq.${foto.imageId}`, { method: "DELETE" });
        await eliminarArchivoStorage(foto.url);
      }
    }

    // 5) Colores que quedan en el formulario, en el orden final (define la portada)
    for (let i = 0; i < coloresForm.length; i++) {
      const color = coloresForm[i];
      btnGuardar.innerHTML = `<span class="spinner"></span>Guardando color ${i + 1}/${coloresForm.length}…`;

      let colorId = color.colorId;
      if (colorId) {
        // Color existente: actualizar sus datos y su posición
        await supabaseFetchAuth(`product_colors?id=eq.${colorId}`, {
          method: "PATCH",
          body: JSON.stringify({ name: color.name.trim(), hex: color.hex, stock: color.stock, sort_order: i })
        });
      } else {
        // Color nuevo (agregado durante la edición, o modo crear)
        const colorCreado = await supabaseFetchAuth("product_colors", {
          method: "POST",
          headers: { Prefer: "return=representation" },
          body: JSON.stringify({
            product_id: productId,
            name: color.name.trim(),
            hex: color.hex,
            stock: color.stock,
            sort_order: i
          })
        });
        colorId = colorCreado[0].id;
      }

      for (let j = 0; j < color.fotos.length; j++) {
        const foto = color.fotos[j];
        if (foto.isExisting) {
          // Foto que ya existía: solo actualizamos su posición si cambió
          await supabaseFetchAuth(`product_images?id=eq.${foto.imageId}`, {
            method: "PATCH",
            body: JSON.stringify({ sort_order: j })
          });
        } else {
          // Foto nueva: subir al bucket y crear su fila
          btnGuardar.innerHTML = `<span class="spinner"></span>Subiendo foto ${j + 1}/${color.fotos.length} (color ${i + 1}/${coloresForm.length})…`;
          const url = await subirFotoAStorage(productId, colorId, foto.file, j);
          await supabaseFetchAuth("product_images", {
            method: "POST",
            body: JSON.stringify({ color_id: colorId, url, sort_order: j })
          });
        }
      }
    }

    cerrarModalProducto();
    alert(modoFormulario === "editar"
      ? `✅ Producto "${nombre}" actualizado correctamente.`
      : `✅ Producto "${nombre}" creado correctamente.`);
    await iniciarPanel(); // refresca la lista de la Parte 2, sin recargar la página

  } catch (err) {
    errBoxGeneral.textContent = "No se pudo guardar: " + err.message;
    errBoxGeneral.classList.add("show");
  } finally {
    btnGuardar.disabled = false;
    btnGuardar.textContent = textoFinalBoton;
  }
});

/* =============================================================
   ARRANQUE DEL PANEL (una vez logueado)
   ============================================================= */
async function iniciarPanel() {
  const wrap = document.getElementById("productsListWrap");
  try {
    productosCache = await traerProductosConDetalle();
    renderProductos();
  } catch (err) {
    wrap.innerHTML = `<div class="placeholder-box">No se pudieron cargar los productos: ${err.message}</div>`;
  }
}

/* =============================================================
   AL CARGAR LA PÁGINA: si ya hay una sesión guardada y válida,
   entra directo al panel sin pedir login de nuevo.
   ============================================================= */
(async function init() {
  const sesion = await obtenerSesionValida();
  if (sesion) {
    mostrarPanel(sesion.email);
    iniciarPanel();
  } else {
    mostrarLogin();
  }
})();
</script>
