/* ---- Estado de los colores del formulario (en memoria, hasta guardar) ----
   modoFormulario: "crear" | "editar"
   productoIdEditando: id del producto que se está editando (null en modo crear)
   coloresEliminados: colores EXISTENTES que el usuario quitó en modo editar
     → [{ colorId, urls: [...fotos existentes de ese color, para borrar del bucket] }]
   fotosEliminadas: fotos EXISTENTES sueltas que el usuario quitó (de un color que
     sigue existiendo) → [{ imageId, url }]
   Ambas listas se procesan recién al tocar "Guardar cambios", no al tocar "Quitar". */
let modoFormulario = "crear";
let productoIdEditando = null;
let coloresForm = [];
let coloresEliminados = [];
let fotosEliminadas = [];

function nuevoColorVacio() {
  return { tempId: crypto.randomUUID(), colorId: null, name: "", hex: "#181614", stock: 0, fotos: [] };
}

function renderColores() {
  const wrap = document.getElementById("coloresWrap");

  if (!coloresForm.length) {
    wrap.innerHTML = `<div class="placeholder-box" style="padding:18px;">Aún no agregaste ningún color. Toca "+ Agregar color".</div>`;
    return;
  }

  wrap.innerHTML = coloresForm.map((color, i) => `
    <div class="color-card">
      <div class="color-card-head">
        <div class="color-order-btns">
          <button type="button" class="btn-color-up" data-tid="${color.tempId}" ${i === 0 ? "disabled" : ""} title="Subir">▲</button>
          <button type="button" class="btn-color-down" data-tid="${color.tempId}" ${i === coloresForm.length - 1 ? "disabled" : ""} title="Bajar">▼</button>
        </div>
        ${i === 0 ? `<span class="color-badge-portada">Portada</span>` : ""}
        <span class="color-index-label">Color ${i + 1}</span>
        <button type="button" class="color-remove-btn" data-tid="${color.tempId}">Quitar color</button>
      </div>
      <div class="color-fields">
        <div class="field">
          <label>Nombre del color</label>
          <input type="text" class="color-name-input" data-tid="${color.tempId}" value="${color.name.replace(/"/g, "&quot;")}" placeholder="Ej. Negro">
        </div>
        <div class="field">
          <label>Color</label>
          <input type="color" class="color-hex-input" data-tid="${color.tempId}" value="${color.hex}">
        </div>
        <div class="field">
          <label>Stock</label>
          <input type="number" class="color-stock-input" data-tid="${color.tempId}" value="${color.stock}" min="0" step="1">
        </div>
      </div>
      <label class="photos-drop">
        📷 Toca para elegir fotos (puedes elegir varias a la vez)
        <input type="file" accept="image/*" multiple class="color-photos-input" data-tid="${color.tempId}" style="display:none;">
      </label>
      <div class="photos-preview-row">
        ${color.fotos.map((foto, j) => `
          <div class="photo-thumb">
            <img src="${foto.previewUrl}" alt="">
            <button type="button" class="photo-remove" data-tid="${color.tempId}" data-fid="${foto.tempId}" title="Quitar foto">✕</button>
            <div class="photo-order">
              <button type="button" class="photo-order-left" data-tid="${color.tempId}" data-fid="${foto.tempId}" ${j === 0 ? "disabled" : ""} title="Mover antes">◀</button>
              <button type="button" class="photo-order-right" data-tid="${color.tempId}" data-fid="${foto.tempId}" ${j === color.fotos.length - 1 ? "disabled" : ""} title="Mover después">▶</button>
            </div>
          </div>`).join("")}
      </div>
    </div>
  `).join("");

  wrap.querySelectorAll(".color-name-input").forEach(inp => {
    inp.addEventListener("input", () => {
      const c = coloresForm.find(x => x.tempId === inp.dataset.tid);
      if (c) c.name = inp.value;
    });
  });
  wrap.querySelectorAll(".color-hex-input").forEach(inp => {
    inp.addEventListener("input", () => {
      const c = coloresForm.find(x => x.tempId === inp.dataset.tid);
      if (c) c.hex = inp.value;
    });
  });
  wrap.querySelectorAll(".color-stock-input").forEach(inp => {
    inp.addEventListener("input", () => {
      const c = coloresForm.find(x => x.tempId === inp.dataset.tid);
      if (c) c.stock = Number(inp.value) || 0;
    });
  });
  wrap.querySelectorAll(".btn-color-up").forEach(btn => {
    btn.addEventListener("click", () => moverColor(btn.dataset.tid, -1));
  });
  wrap.querySelectorAll(".btn-color-down").forEach(btn => {
    btn.addEventListener("click", () => moverColor(btn.dataset.tid, 1));
  });
  wrap.querySelectorAll(".color-remove-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const c = coloresForm.find(x => x.tempId === btn.dataset.tid);
      // Si el color ya existía en la base de datos, anotamos sus fotos existentes
      // para borrarlas del bucket de Storage recién cuando se guarde el formulario
      // (borrar la fila de product_colors ya borra en cascada sus product_images).
      if (c && c.colorId) {
        const urls = c.fotos.filter(f => f.isExisting).map(f => f.url);
        coloresEliminados.push({ colorId: c.colorId, urls });
      }
      coloresForm = coloresForm.filter(x => x.tempId !== btn.dataset.tid);
      renderColores();
    });
  });
  wrap.querySelectorAll(".color-photos-input").forEach(inp => {
    inp.addEventListener("change", (e) => {
      const c = coloresForm.find(x => x.tempId === inp.dataset.tid);
      if (!c) return;
      Array.from(e.target.files).forEach(file => {
        c.fotos.push({
          tempId: crypto.randomUUID(),
          imageId: null,
          url: null,
          isExisting: false,
          file,
          previewUrl: URL.createObjectURL(file)
        });
      });
      inp.value = ""; // permite volver a elegir el mismo archivo si se quita y se agrega otra vez
      renderColores();
    });
  });
  wrap.querySelectorAll(".photo-remove").forEach(btn => {
    btn.addEventListener("click", () => {
      const c = coloresForm.find(x => x.tempId === btn.dataset.tid);
      if (!c) return;
      const foto = c.fotos.find(f => f.tempId === btn.dataset.fid);
      if (foto && foto.isExisting) {
        fotosEliminadas.push({ imageId: foto.imageId, url: foto.url });
      }
      c.fotos = c.fotos.filter(f => f.tempId !== btn.dataset.fid);
      renderColores();
    });
  });
  wrap.querySelectorAll(".photo-order-left").forEach(btn => {
    btn.addEventListener("click", () => moverFoto(btn.dataset.tid, btn.dataset.fid, -1));
  });
  wrap.querySelectorAll(".photo-order-right").forEach(btn => {
    btn.addEventListener("click", () => moverFoto(btn.dataset.tid, btn.dataset.fid, 1));
  });
}

function moverColor(tempId, delta) {
  const i = coloresForm.findIndex(c => c.tempId === tempId);
  const j = i + delta;
  if (i < 0 || j < 0 || j >= coloresForm.length) return;
  [coloresForm[i], coloresForm[j]] = [coloresForm[j], coloresForm[i]];
  renderColores();
}

function moverFoto(tempId, fotoId, delta) {
  const c = coloresForm.find(x => x.tempId === tempId);
  if (!c) return;
  const i = c.fotos.findIndex(f => f.tempId === fotoId);
  const j = i + delta;
  if (i < 0 || j < 0 || j >= c.fotos.length) return;
  [c.fotos[i], c.fotos[j]] = [c.fotos[j], c.fotos[i]];
  renderColores();
}

