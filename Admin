let productosCache = [];
let filtroEstado = "todos"; // "todos" | "activos" | "inactivos"

/* Trae products con su categoría y colores/fotos anidados, en UNA sola consulta
   (usamos el "embed" de PostgREST en vez de pedir cada tabla por separado). */
async function traerProductosConDetalle() {
  const path =
    "products?select=" +
    encodeURIComponent(
      "id,name,price,price_wholesale,discount_percent,is_active,sort_order," +
      "categories(name)," +
      "product_colors(id,name,sort_order,product_images(url,sort_order))"
    ) +
    "&order=sort_order.asc";
  return supabaseFetchAuth(path);
}

/* De los colores de un producto, agarra el color "portada" (sort_order más bajo)
   y de ahí su primera foto (también por sort_order). */
function fotoPortada(producto) {
  const colores = producto.product_colors || [];
  if (!colores.length) return null;
  const portada = [...colores].sort((a, b) => a.sort_order - b.sort_order)[0];
  const fotos = portada.product_images || [];
  if (!fotos.length) return null;
  return [...fotos].sort((a, b) => a.sort_order - b.sort_order)[0].url;
}

function formatearPrecio(n) {
  return "S/ " + Number(n).toFixed(2);
}

function renderProductos() {
  const wrap = document.getElementById("productsListWrap");
  const countLabel = document.getElementById("countLabel");

  let lista = productosCache;
  if (filtroEstado === "activos") lista = lista.filter(p => p.is_active);
  if (filtroEstado === "inactivos") lista = lista.filter(p => !p.is_active);

  countLabel.textContent = `${lista.length} de ${productosCache.length} producto(s)`;

  if (!lista.length) {
    wrap.innerHTML = `<div class="placeholder-box">No hay productos que mostrar con este filtro.</div>`;
    return;
  }

  wrap.innerHTML = lista.map(p => {
    const foto = fotoPortada(p);
    const categoria = p.categories ? p.categories.name : "—";
    const tieneDescuento = p.discount_percent && p.discount_percent > 0;
    const precioFinal = tieneDescuento
      ? p.price - (p.price * p.discount_percent / 100)
      : p.price;

    return `
      <div class="product-row${p.is_active ? "" : " inactive"}" data-id="${p.id}">
        <div class="product-thumb">
          ${foto ? `<img src="${foto}" alt="${p.name}">` : `<span class="no-photo">Sin foto</span>`}
        </div>
        <div class="product-info">
          <div class="name">${p.name}</div>
          <div class="meta">
            ${categoria}
            <span class="badge ${p.is_active ? "badge-active" : "badge-inactive"}" style="margin-left:8px;">
              ${p.is_active ? "Activo" : "Inactivo"}
            </span>
          </div>
        </div>
        <div class="product-price">
          ${tieneDescuento ? `<span class="old">${formatearPrecio(p.price)}</span>` : ""}
          ${formatearPrecio(precioFinal)}
        </div>
        <div class="product-actions">
          <button class="btn-sm btn-editar" data-id="${p.id}">Editar</button>
          <button class="btn-sm btn-toggle" data-id="${p.id}" data-active="${p.is_active}">
            ${p.is_active ? "Desactivar" : "Activar"}
          </button>
        </div>
      </div>`;
  }).join("");

  wrap.querySelectorAll(".btn-toggle").forEach(btn => {
    btn.addEventListener("click", () => alternarActivo(btn.dataset.id, btn.dataset.active === "true"));
  });
  wrap.querySelectorAll(".btn-editar").forEach(btn => {
    btn.addEventListener("click", () => {
      abrirModalEditarProducto(btn.dataset.id);
    });
  });
}

async function alternarActivo(id, estaActivoAhora) {
  const fila = document.querySelector(`.product-row[data-id="${id}"]`);
  const btn = fila ? fila.querySelector(".btn-toggle") : null;
  if (btn) { btn.disabled = true; btn.textContent = "…"; }

  try {
    await supabaseFetchAuth(`products?id=eq.${id}`, {
      method: "PATCH",
      body: JSON.stringify({ is_active: !estaActivoAhora })
    });
    const p = productosCache.find(x => x.id === id);
    if (p) p.is_active = !estaActivoAhora;
    renderProductos();
  } catch (err) {
    alert("No se pudo actualizar: " + err.message);
    if (btn) { btn.disabled = false; btn.textContent = estaActivoAhora ? "Desactivar" : "Activar"; }
  }
}

