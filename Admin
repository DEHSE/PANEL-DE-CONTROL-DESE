/* ---- Generación del slug (id), MISMA lógica que migrar-datos.js ---- */
function slugify(...partes) {
  return partes
    .join("-")
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "") // quita tildes
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

/* Genera un slug único consultando a Supabase, igual que hacía el
   script de migración (pero ahí lo comparaba contra un Set en memoria
   porque migraba todo de una vez; acá, como se crea un producto a la
   vez, lo consultamos directo en la base para estar siempre al día). */
async function generarSlugUnico(categoriaNombre, nombreProducto) {
  const idBase = slugify(categoriaNombre || "sin-categoria", nombreProducto);
  let id = idBase;
  let sufijo = 2;
  while (true) {
    const existe = await supabaseFetchAuth(`products?id=eq.${encodeURIComponent(id)}&select=id`);
    if (!existe || !existe.length) return id;
    id = `${idBase}-${sufijo++}`;
  }
}

