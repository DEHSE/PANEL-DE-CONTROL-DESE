    coloresForm = coloresOrdenados.map(c => ({
      tempId: crypto.randomUUID(),
      colorId: c.id,
      name: c.name || "",
      hex: c.hex || "#181614",
      stock: c.stock || 0,
      fotos: [...(c.product_images || [])]
        .sort((a, b) => a.sort_order - b.sort_order)
        .map(img => ({
          tempId: crypto.randomUUID(),
          imageId: img.id,
          url: img.url,
          isExisting: true,
          file: null,
          previewUrl: img.url
        }))
    }));
    renderColores();

    btnGuardar.disabled = false;
    btnGuardar.textContent = "Guardar cambios";
  } catch (err) {
    document.getElementById("pfGeneralError").textContent =
      "No se pudo cargar el producto: " + err.message;
    document.getElementById("pfGeneralError").classList.add("show");
    btnGuardar.disabled = false;
    btnGuardar.textContent = "Guardar cambios";
  }
}

