    document.getElementById("pfNombre").value = p.name || "";
    document.getElementById("pfGenero").value = p.gender || "";
    document.getElementById("pfPrecio").value = p.price ?? "";
    document.getElementById("pfPrecioMayor").value = p.price_wholesale ?? "";
